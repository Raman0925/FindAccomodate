# Copy to `.env.local` (gitignored). Restart Metro: npx react-native start --reset-cache

PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_KEY=your_publishable_or_anon_key

# Google Cloud → Credentials → OAuth client (Web application). Public ID only — never the secret.
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# iOS OAuth client ID (use when not using GoogleService-Info.plist)
GOOGLE_IOS_CLIENT_ID=
