{
  "name": "basera",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "build:android": "node scripts/build-android-debug.js",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "react-native start",
    "test": "jest",
    "compile": "tsc --noEmit",
    "test-coverage": "jest --coverage --ci",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix"
    ],
    "App.tsx": [
      "eslint --max-warnings=0 --fix"
    ],
    "index.js": [
      "eslint --max-warnings=0 --fix"
    ],
    "jest.setup.js": [
      "eslint --max-warnings=0 --fix"
    ],
    "__tests__/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix"
    ],
    "__mocks__/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/html-elements": "^0.10.1",
    "@gluestack-ui/core": "^3.0.10",
    "@gluestack-ui/utils": "^3.0.11",
    "@legendapp/motion": "^2.3.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@supabase/supabase-js": "^2.101.1",
    "metro-react-native-babel-preset": "^0.77.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "mobx-state-tree": "^7.2.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-aria": "^3.33.0",
    "react-dom": "^19.2.4",
    "react-native": "0.84.1",
    "react-native-bootsplash": "^6.3.12",
    "react-native-gesture-handler": "^2.31.0",
    "react-native-inappbrowser-reborn": "^3.7.1",
    "react-native-keyboard-controller": "^1.21.3",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.13.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "^0.8.1",
    "react-stately": "^3.39.0",
    "tailwind-variants": "^0.1.20"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
